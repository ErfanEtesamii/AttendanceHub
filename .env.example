# Development only. Never use these sample secrets in production.
ENVIRONMENT=development
POSTGRES_USER=attendhub
POSTGRES_PASSWORD=attendhub_local_password
POSTGRES_DB=attendhub
DATABASE_URL=postgresql+psycopg://attendhub:attendhub_local_password@postgres:5432/attendhub
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-random-encryption-key-of-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
FRONTEND_INTERNAL_URL=http://frontend:3000
BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000
# console is allowed only when ENVIRONMENT=development.
OTP_PROVIDER=console
# Optional public username for the shared Telegram bot (without @).
SHARED_BOT_USERNAME=
# Existing account that becomes the Faraz Honar owner when the idempotent seed runs.
FARAZHONAR_OWNER_EMAIL=
APP_PUBLIC_URL=http://localhost:3000
# Production SMTP (required when OTP_PROVIDER=smtp).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Comma-separated proxy CIDRs permitted to supply X-Forwarded-For. Empty is safest.
TRUSTED_PROXIES=
